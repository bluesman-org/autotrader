<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      Accepted findings, each scoped to the classes its reason covers: a class that is not listed
      here and trips one of these patterns is still a gate failure. Everything not listed must be
      fixed rather than added below.
    -->

    <!-- Internal carriers hand around their own lists and indicator arrays: nothing crosses a
         trust boundary, the web layer serializes copies, and defensive copying of the indicator
         arrays would allocate per bar in the hot path. The two service-shaped classes hold
         framework collaborators (RestTemplate, the candle stream), which Spring manages. The
         records that carry a stored run (RunSummaryView, BacktestEntryTrades) do so for display,
         and the run is already published through the API as-is. The auth and settings controllers
         hold Spring-managed service collaborators for the same reason the two service-shaped
         classes do. -->
    <Match>
        <Or>
            <Class name="nl.jimkaplan.autotrader.strategy.backtest.BacktestEntryTrades"/>
            <Class name="nl.jimkaplan.autotrader.strategy.backtest.BacktestResult"/>
            <Class name="nl.jimkaplan.autotrader.strategy.backtest.SweepDefinition"/>
            <Class name="nl.jimkaplan.autotrader.strategy.backtest.SweepResult"/>
            <Class name="nl.jimkaplan.autotrader.strategy.controller.LiveStrategyView"/>
            <Class name="nl.jimkaplan.autotrader.strategy.controller.RuleSetRequest"/>
            <Class name="nl.jimkaplan.autotrader.strategy.controller.RunSummaryView"/>
            <Class name="nl.jimkaplan.autotrader.strategy.indicator.MacdResult"/>
            <Class name="nl.jimkaplan.autotrader.strategy.live.LiveStrategyRunner"/>
            <Class name="nl.jimkaplan.autotrader.strategy.rule.CandleSeries"/>
            <Class name="nl.jimkaplan.autotrader.strategy.rule.IndicatorSeries"/>
            <Class name="nl.jimkaplan.autotrader.strategy.rule.StrategySignals"/>
            <Class name="nl.jimkaplan.autotrader.controller.AuthController"/>
            <Class name="nl.jimkaplan.autotrader.controller.HomeController"/>
            <Class name="nl.jimkaplan.autotrader.controller.SettingsUiController"/>
            <Class name="nl.jimkaplan.autotrader.bitvavo.client.BitvavoApiClient"/>
            <Class name="nl.jimkaplan.autotrader.strategy.live.BitvavoCandleStream"/>
        </Or>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Logs go to a local file on a private network; these classes log ids, markets and numbers
         that arrive over the API. Sanitizing every argument is disproportionate to the risk. -->
    <Match>
        <Or>
            <Class name="nl.jimkaplan.autotrader.bitvavo.controller.TransactionHistoryController"/>
            <Class name="nl.jimkaplan.autotrader.bitvavo.service.TransactionHistoryService"/>
            <Class name="nl.jimkaplan.autotrader.controller.BotConfigurationController"/>
            <Class name="nl.jimkaplan.autotrader.strategy.service.LiveStrategyService"/>
        </Or>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- These APIs return the stored backtest-run and live-strategy documents by design, which is
         the contract the UI consumes. Neither holds credentials: a live strategy references a bot
         by id, and bot configuration credentials are transient, never serialized. -->
    <Match>
        <Or>
            <Class name="nl.jimkaplan.autotrader.strategy.controller.BacktestController"/>
            <Class name="nl.jimkaplan.autotrader.strategy.controller.LiveStrategyController"/>
        </Or>
        <Bug pattern="ENTITY_LEAK"/>
    </Match>

    <!-- openapi.export-dir is an operator-set property, not user input. -->
    <Match>
        <Class name="nl.jimkaplan.autotrader.config.OpenApiConfig"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
</FindBugsFilter>
